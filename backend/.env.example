# Application
APP_NAME=Data Intelligence Platform
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./dip.db
# DATABASE_URL=postgresql://user:password@localhost:5432/dip

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# First superadmin (seeded on startup)
FIRST_SUPERADMIN_EMAIL=admin@dip.local
FIRST_SUPERADMIN_PASSWORD=Admin@1234!

# AI / External services (add as needed)
OPENAI_API_KEY=
OCR_API_KEY=

# ZIP Batch Upload (Document Intelligence + Invoice Intelligence) — one ZIP
# upload extracts to many documents, deduplicated and processed through the
# existing per-document pipeline via bounded parallel workers. All limits
# below are enforced server-side (zip_security_service.py); defaults are
# sane for most deployments — raise MAX_ZIP_SIZE_MB/MAX_FILES_PER_ZIP for
# very large archives, but see README_DEPLOYMENT.md's scalability note
# before pushing a single ZIP well past a few thousand entries.
ZIP_UPLOAD_ENABLED=true
MAX_ZIP_SIZE_MB=10240
MAX_EXTRACTED_SIZE_MB=51200
MAX_FILES_PER_ZIP=10000
MAX_SINGLE_FILE_SIZE_MB=5120
MAX_ZIP_DEPTH=20
MAX_COMPRESSION_RATIO=100
ALLOW_NESTED_ZIP=false
ZIP_RETENTION_DAYS=30
EXTRACTED_FILE_RETENTION_DAYS=30
AUTO_PROCESS_AFTER_UPLOAD=true
UPLOAD_CHUNK_SIZE_MB=8
UPLOAD_CONCURRENCY=4
BATCH_INSERT_SIZE=500
PROCESSING_BATCH_SIZE=50

# Document-processing concurrency — shared by manual upload, bulk upload,
# document schedules, AND ZIP batch tasks (one real global cap, not three
# uncoordinated ones). OCR_CONCURRENCY/AI_CONCURRENCY are finer sub-limits
# inside a single document's own pipeline stages.
DOCUMENT_WORKER_COUNT=4
OCR_CONCURRENCY=4
AI_CONCURRENCY=4
